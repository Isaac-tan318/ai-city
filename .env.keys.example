# Template for .env.keys - copy this file to .env.keys and fill in the values you use.
#
#   cp .env.keys.example .env.keys
#
# .env.keys is git-ignored and holds your real secrets locally. It lets you restore all
# Convex deployment env vars (`npx convex env set ...`) in one command after swapping to a
# different Convex account/project, via `npm run env:push`. See README.md "Connect an LLM"
# for what each provider's variables do.
#
# Only fill in the block for the provider you're actually using; leave the rest blank/removed.

# --- Custom / OpenAI-compatible endpoint (e.g. OpenRouter, Azure, Groq, Anthropic) ---
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_EMBEDDING_URL=
LLM_EMBEDDING_API_KEY=
LLM_EMBEDDING_MODEL=

# --- OpenAI ---
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=
# OPENAI_EMBEDDING_MODEL=

# --- Together.ai ---
# TOGETHER_API_KEY=
# TOGETHER_CHAT_MODEL=
# TOGETHER_EMBEDDING_MODEL=

# --- Ollama (only needed if tunneling a local instance) ---
# OLLAMA_HOST=
# OLLAMA_MODEL=
# OLLAMA_EMBEDDING_MODEL=

# --- Background music (Replicate) ---
# REPLICATE_API_TOKEN=

# --- Auth (Clerk), optional ---
# CLERK_SECRET_KEY=
# CLERK_ISSUER_URL=
